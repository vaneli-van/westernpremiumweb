# Quotation form backend. Copy to .env.local for local development and set the same
# values in the Vercel project (Settings > Environment Variables) for deployments.

# Cloudflare Turnstile (invisible widget). Both values come from the same Turnstile site.
# Without them the form shows a "not configured" banner and submission is disabled.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Resend. The sender domain in content/company.ts (company.formSender) must be verified in Resend.
# Without this key the form shows a "not configured" banner and submission is disabled.
RESEND_API_KEY=

# Vercel Blob (private store) for specification and bill of quantities attachments.
# Added automatically when a Blob store is connected to the Vercel project.
# Without it the form shows a banner and the attachment field is disabled.
BLOB_READ_WRITE_TOKEN=

# Optional: Google Maps Embed API key for the map on /contact.
# Without it only the "Open in Google Maps" link is shown.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Optional: canonical site URL used in metadata.
NEXT_PUBLIC_SITE_URL=
